# Copy to .env locally or add each value as a Codespaces secret.
# Never commit real credentials or share them in chat.
MONGODB_URI=mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER_HOST>/RentACar?retryWrites=true&w=majority
ADMIN_API_KEY=replace_with_a_long_random_secret_at_least_32_characters
SESSION_SECRET=replace_with_a_different_long_random_secret_at_least_32_characters
PORT=3000
