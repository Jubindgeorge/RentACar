<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RentACar Admin</title>
<style>
:root{font-family:Inter,system-ui,sans-serif;color:#17243a;background:#f4f7fb}*{box-sizing:border-box}body{margin:0}header{background:#111d33;color:white;padding:22px max(18px,calc((100% - 1180px)/2));display:flex;align-items:center;justify-content:space-between;gap:15px;flex-wrap:wrap}main{max-width:1180px;margin:28px auto;padding:0 18px}.panel{background:white;border:1px solid #e1e8f0;border-radius:16px;padding:20px;margin:18px 0;box-shadow:0 8px 24px #1327430a}.row{display:flex;gap:12px;flex-wrap:wrap}.row>*{flex:1;min-width:180px}input,select,textarea{width:100%;padding:12px;border:1px solid #ccd6e2;border-radius:9px;margin:6px 0 12px;font:inherit}button{background:#087f72;color:white;border:0;border-radius:9px;padding:12px 16px;font-weight:700;cursor:pointer}button.secondary{background:#e7edf5;color:#24344b}.muted{color:#65758b}.status{padding:10px 0;min-height:28px}.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:12px}.item{border:1px solid #e2e8f0;border-radius:12px;padding:14px}.item h3{margin:0 0 8px}.danger{background:#9e3434}small{overflow-wrap:anywhere}h1{margin:0}.token{max-width:700px}@media(max-width:600px){.panel{padding:14px}}
</style></head><body><header><h1>RentACar Admin</h1><a href="/fleet" style="color:white">View fleet ↗</a></header>
<main><section class="panel token"><h2>Secure admin access</h2><p class="muted">Enter the ADMIN_API_KEY configured in your server environment. It is kept in this tab's session storage only.</p><label for="key">Admin API key</label><input id="key" type="password" autocomplete="off" placeholder="Paste admin key"><div class="row"><button id="connect">Connect & load data</button><button id="forget" class="secondary">Forget key</button></div><div id="status" class="status" role="status"></div></section>
<section class="panel"><h2>Add a vehicle</h2><form id="carform"><div class="row"><div><label>Vehicle name</label><input name="name" required maxlength="120" placeholder="Toyota Camry"></div><div><label>Brand</label><input name="brand" required placeholder="Toyota"></div><div><label>Model</label><input name="model" required placeholder="Camry"></div></div><div class="row"><div><label>Year</label><input name="year" type="number" min="1950" max="2100" required></div><div><label>Daily rate (AED)</label><input name="dailyRate" type="number" min="0" step="0.01" required></div><div><label>Seats</label><input name="seats" type="number" min="1" max="20" value="5"></div></div><div class="row"><div><label>Category</label><input name="category" value="Standard"></div><div><label>Transmission</label><select name="transmission"><option>Automatic</option><option>Manual</option></select></div><div><label>Fuel</label><select name="fuel"><option>Petrol</option><option>Diesel</option><option>Hybrid</option><option>Electric</option></select></div></div><label>Image URL (optional)</label><input name="imageUrl" type="url" placeholder="https://..."><label>Description</label><textarea name="description" rows="2" maxlength="2000"></textarea><button type="submit">Add vehicle</button></form></section>
<section class="panel"><div class="row" style="align-items:center"><div><h2>Fleet inventory</h2><p class="muted">Mark cars unavailable rather than deleting history.</p></div><div style="text-align:right"><button id="refreshCars" class="secondary">Refresh fleet</button></div></div><div id="cars" class="cards"></div></section>
<section class="panel"><div class="row" style="align-items:center"><div><h2>Bookings</h2><p class="muted">Review customer requests and update booking status.</p></div><div style="text-align:right"><button id="refreshBookings" class="secondary">Refresh bookings</button></div></div><div id="bookings" class="cards"></div></section>
<section class="panel"><div class="row" style="align-items:center"><div><h2>Registered customers</h2><p class="muted">Passwords are never returned by this endpoint.</p></div><div style="text-align:right"><button id="refreshUsers" class="secondary">Refresh customers</button></div></div><div id="users" class="cards"></div></section>
<section class="panel"><div class="row" style="align-items:center"><div><h2>Login activity</h2><p class="muted">Recent login, registration, and logout events.</p></div><div style="text-align:right"><button id="refreshActivity" class="secondary">Refresh activity</button></div></div><div id="activity" class="cards"></div></section>
<section class="panel"><h2>Location sharing</h2><p class="muted">Only bookings where the customer explicitly enabled location sharing will appear here.</p><button id="refreshLocations" class="secondary">Load consented locations</button><div id="locations" class="cards" style="margin-top:12px"></div></section>
</main>
<script>
const $=id=>document.getElementById(id), keyInput=$('key'), status=$('status');
keyInput.value=sessionStorage.getItem('rentacar_admin_key')||'';
function esc(v){return String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));}
async function api(path,options={}){const r=await fetch('/api'+path,{...options,headers:{'Content-Type':'application/json','x-admin-key':keyInput.value,...(options.headers||{})}});const d=await r.json().catch(()=>({error:'Invalid server response'}));if(!r.ok)throw new Error(d.error||'Request failed ('+r.status+')');return d;}
async function loadCars(){const d=await api('/admin/cars');$('cars').innerHTML=d.cars.length?d.cars.map(c=>'<article class="item"><h3>'+esc(c.name)+'</h3><p class="muted">'+esc(c.brand)+' '+esc(c.model)+' · '+c.year+'</p><strong>'+Number(c.dailyRate).toFixed(2)+' '+esc(c.currency||'AED')+'/day</strong><p>Status: '+(c.available?'Available':'Unavailable')+'</p>'+(c.available?'<button class="danger" data-unavailable="'+c._id+'">Mark unavailable</button>':'')+'</article>').join(''):'<p class="muted">No vehicles have been added.</p>';}
async function loadBookings(){const d=await api('/admin/bookings');$('bookings').innerHTML=d.bookings.length?d.bookings.map(b=>'<article class="item"><h3>'+esc(b.customerName)+'</h3><p>'+esc(b.customerEmail)+' · '+esc(b.customerPhone)+'</p><p>'+esc(b.car?.name||'Car unavailable')+'</p><p>'+new Date(b.pickupAt).toLocaleString()+' → '+new Date(b.dropoffAt).toLocaleString()+'</p><strong>'+Number(b.totalPrice).toFixed(2)+' '+esc(b.currency)+'</strong><p>Current status: '+esc(b.status)+'</p><select data-status="'+b._id+'"><option>pending</option><option>confirmed</option><option>active</option><option>completed</option><option>cancelled</option></select><button data-save-status="'+b._id+'">Update status</button></article>').join(''):'<p class="muted">No bookings yet.</p>';for(const b of d.bookings){const el=document.querySelector('[data-status="'+b._id+'"]');if(el)el.value=b.status;}}
async function connect(){try{sessionStorage.setItem('rentacar_admin_key',keyInput.value);status.textContent='Checking access…';await Promise.all([loadCars(),loadBookings(),loadUsers(),loadActivity()]);status.textContent='Connected. Admin API authorization passed.';}catch(e){status.textContent=e.message;}}
$('connect').onclick=connect;$('forget').onclick=()=>{sessionStorage.removeItem('rentacar_admin_key');keyInput.value='';status.textContent='Key cleared from this tab.';};
async function loadUsers(){const d=await api('/admin/users');$('users').innerHTML=d.users.length?d.users.map(u=>'<article class="item"><h3>'+esc(u.fullname)+'</h3><p>'+esc(u.email)+'</p><small>Registered: '+new Date(u.createdAt).toLocaleString()+'</small></article>').join(''):'<p class="muted">No registered customers yet.</p>';}
async function loadActivity(){const d=await api('/admin/login-activity');$('activity').innerHTML=d.activity.length?d.activity.map(a=>'<article class="item"><h3>'+esc(a.event.replace(/_/g,' '))+'</h3><p>'+esc(a.email)+'</p><small>'+new Date(a.createdAt).toLocaleString()+' · '+esc(a.ipAddress)+'</small></article>').join(''):'<p class="muted">No login activity yet.</p>';}
$('refreshUsers').onclick=()=>loadUsers().catch(e=>status.textContent=e.message);$('refreshActivity').onclick=()=>loadActivity().catch(e=>status.textContent=e.message);
$('refreshCars').onclick=()=>loadCars().catch(e=>status.textContent=e.message);$('refreshBookings').onclick=()=>loadBookings().catch(e=>status.textContent=e.message);
$('carform').onsubmit=async e=>{e.preventDefault();try{const body=Object.fromEntries(new FormData(e.target));for(const k of ['year','dailyRate','seats'])body[k]=Number(body[k]);const d=await api('/admin/cars',{method:'POST',body:JSON.stringify(body)});status.textContent='Added '+d.car.name+'.';e.target.reset();await loadCars();}catch(err){status.textContent=err.message;}};
$('cars').onclick=async e=>{const id=e.target.dataset.unavailable;if(!id)return;if(!confirm('Mark this vehicle unavailable? Booking history will be preserved.'))return;try{await api('/admin/cars/'+id,{method:'DELETE'});await loadCars();status.textContent='Vehicle marked unavailable.';}catch(err){status.textContent=err.message;}};
$('bookings').onclick=async e=>{const id=e.target.dataset.saveStatus;if(!id)return;const statusValue=document.querySelector('[data-status="'+id+'"]').value;try{await api('/admin/bookings/'+id+'/status',{method:'PATCH',body:JSON.stringify({status:statusValue})});status.textContent='Booking status updated.';await loadBookings();}catch(err){status.textContent=err.message;}};
$('refreshLocations').onclick=async()=>{try{const d=await api('/admin/location-sharing');$('locations').innerHTML=d.locations.length?d.locations.map(x=>'<article class="item"><h3>'+esc(x.customerName)+'</h3><p>'+esc(x.car?.name||'Rental car')+'</p><p>Latitude: '+x.lastSharedLocation.latitude+'<br>Longitude: '+x.lastSharedLocation.longitude+'</p><small>Last update: '+new Date(x.lastSharedLocation.updatedAt).toLocaleString()+'</small></article>').join(''):'<p class="muted">No current location shares with recent coordinates.</p>';}catch(e){status.textContent=e.message;}};
if(keyInput.value)connect();
</script></body></html>