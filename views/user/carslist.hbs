@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');
html{scroll-behavior:smooth}body.bodylist{font-family:'DM Sans',Arial,sans-serif;background:#f7f6f2;color:#191916}.headers{background:rgba(255,255,255,.96);backdrop-filter:blur(12px);box-shadow:0 5px 22px #1919160a}.navbar .name{font:800 29px Manrope,sans-serif;letter-spacing:-1.5px;color:#191916}.navbar .linkcar a{transition:color .18s}.navbar .linkcar a:hover{color:#a17e43}.open-button,.form-popup button,.container_car button{border-radius:12px;transition:transform .18s,box-shadow .18s}.open-button:hover,.form-popup button:hover{box-shadow:0 8px 24px #19191612;transform:translateY(-1px)}input,select,button{font-family:inherit}input:focus-visible,select:focus-visible,button:focus-visible,a:focus-visible{outline:3px solid #c9a96e;outline-offset:3px}@media(max-width:760px){.headers{position:relative;padding:12px 0}.navbar{gap:12px;align-items:flex-start;flex-direction:column}.navbar .linkcar{display:flex;flex-wrap:wrap;gap:12px;padding:0}.container_car{max-width:100%;padding-left:14px;padding-right:14px}}</style>
