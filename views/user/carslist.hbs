<script>
function openForm() {
  document.getElementById("myForm").style.display = "block";
}

function closeForm() {
  document.getElementById("myForm").style.display = "none";
}
function openForm1() {
  document.getElementById("myForm1").style.display = "block";
}

function closeForm1() {
  document.getElementById("myForm1").style.display = "none";
}
function openForm2() {
  document.getElementById("myForm2").style.display = "block";
}

function closeForm2() {
  document.getElementById("myForm2").style.display = "none";
}
function openForm3() {
  document.getElementById("myForm3").style.display = "block";
}

function closeForm3() {
  document.getElementById("myForm3").style.display = "none";
}
function selectcity() {
  let city = document.getElementById("cars").value
  document.getElementById("pick").innerHTML = city
}
function pickupdate() {
  let pickup = document.getElementById("PickUP").value
  document.getElementById("date").innerHTML = pickup
}
function dropcity() {
  let dropin = document.getElementById("dropoff").value
  document.getElementById("drop").innerHTML = dropin
}
function dropindate() {
  let dropoffdate = document.getElementById("dropup").value
  document.getElementById("dropout").innerHTML = dropoffdate
}
