<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RentACar | Fleet</title>
<link rel="stylesheet" href="/stylesheets/modern.css"><style>
:root{font-family:'DM Sans',Arial,sans-serif;color:#111;background:#f7f7f5}*{box-sizing:border-box}body{margin:0}header{background:#fff;color:#111;padding:0 max(14px,calc((100% - 1180px)/2));min-height:80px;display:flex;justify-content:space-between;align-items:center;gap:16px;border-bottom:1px solid #e8e8e8;flex-wrap:wrap}header strong{font:800 24px Manrope,sans-serif;letter-spacing:-1px}header nav{display:flex;gap:24px;flex-wrap:wrap}header a{color:#111;text-decoration:none;font-size:13px;font-weight:700;margin:0}.hero{max-width:1180px;margin:0 auto;padding:46px 20px 25px}.hero h1{font:800 clamp(36px,5vw,58px)/1.05 Manrope,sans-serif;letter-spacing:-2.8px;margin:10px 0}.muted{color:#707070;line-height:1.65}.grid{max-width:1180px;margin:0 auto;padding:8px 20px 55px;display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:18px}.card{background:white;border:1px solid #e6e6e3;border-radius:20px;overflow:hidden;box-shadow:0 8px 25px #00000007}.card img{width:100%;height:195px;object-fit:cover;background:#e9e9e6}.content{padding:20px}.content h2{font:800 22px Manrope,sans-serif;margin:13px 0 8px}.price{font:800 23px Manrope;color:#111;margin-top:18px}.pill{display:inline-block;background:#c9a96e;color:#111;border-radius:999px;padding:6px 10px;font-size:10px;letter-spacing:.6px;text-transform:uppercase;font-weight:800}.empty{grid-column:1/-1;background:white;border:1px dashed #ccc;padding:34px;border-radius:20px;text-align:center}.btn{display:inline-flex;align-items:center;justify-content:center;background:#111;color:white;text-decoration:none;border:1px solid #111;border-radius:999px;padding:12px 17px;font-weight:800;cursor:pointer}.btn:hover{opacity:.82}.secondary{background:#f1f1ee;color:#111;border-color:#e1e1dc}.notice{max-width:1180px;margin:0 auto 12px;padding:0 20px;color:#8a3b13;font-size:13px}.booking{display:none;border-top:1px solid #e8e8e8;margin-top:17px;padding-top:14px}.booking.open{display:block}.booking label{display:block;font-size:12px;font-weight:800;margin-top:11px}.booking input{width:100%;padding:12px;border:1px solid #deded9;border-radius:10px;margin-top:6px;font:inherit}.booking input:focus{outline:2px solid #c9a96e;border-color:#111}.feedback{font-size:13px;line-height:1.6;overflow-wrap:anywhere;margin-top:12px}.share{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap}footer{text-align:center;padding:25px;color:#777;border-top:1px solid #e8e8e8;font-size:12px}@media(max-width:600px){header{padding:14px;align-items:flex-start;flex-direction:column}header nav{gap:17px}.hero{padding:30px 14px 16px}.grid{padding:6px 14px 35px}.card img{height:180px}.content{padding:16px}}
</style></head><body>
<header><strong>RentACar</strong><nav><a href="/">Home</a><a href="/fleet">Browse cars</a><a href="/users/login">Sign in</a></nav></header>
<section class="hero"><h1>Find your next ride.</h1><p class="muted">Explore available vehicles and submit a rental request. Rates are shown per day in AED unless specified.</p></section>
<div id="notice" class="notice" role="status"></div><main id="cars" class="grid"><div class="empty">Loading available cars…</div></main><footer>RentACar · Drive with confidence</footer>
<script>
(async function(){
 const target=document.getElementById('cars'),notice=document.getElementById('notice');
 const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 try{
  const response=await fetch('/api/cars');const data=await response.json();if(!response.ok)throw new Error(data.error||'Unable to load cars.');
  if(!data.cars.length){target.innerHTML='<div class="empty"><h2>No cars listed yet</h2><p class="muted">Please check back soon.</p></div>';return;}
  target.innerHTML=data.cars.map(car=>'<article class="card">'+(car.imageUrl?'<img loading="lazy" src="'+esc(car.imageUrl)+'" alt="'+esc(car.name)+'">':'<div style="height:180px;display:grid;place-items:center;background:#e7edf5;color:#75849a">Vehicle image not available</div>')+'<div class="content"><span class="pill">'+esc(car.category||'Standard')+'</span><h2>'+esc(car.name)+'</h2><p class="muted">'+esc(car.brand)+' '+esc(car.model)+' · '+car.seats+' seats · '+esc(car.transmission)+'</p><p>'+esc(car.description||'Comfortable, reliable rental vehicle.')+'</p><div class="price">'+Number(car.dailyRate).toLocaleString(undefined,{maximumFractionDigits:2})+' '+esc(car.currency||'AED')+' <small style="font-size:13px;font-weight:500">/ day</small></div><button class="btn" style="margin-top:14px" data-open="'+car._id+'">Request booking</button><form class="booking" data-booking="'+car._id+'"><label>Full name<input name="customerName" autocomplete="name" required maxlength="120"></label><label>Email<input name="customerEmail" type="email" autocomplete="email" required maxlength="254"></label><label>Phone<input name="customerPhone" type="tel" autocomplete="tel" required maxlength="40"></label><label>Pickup location<input name="pickupLocation" required maxlength="200" value="'+esc(car.pickupLocation||'Abu Dhabi')+'"></label><label>Drop-off location<input name="dropoffLocation" required maxlength="200" value="'+esc(car.pickupLocation||'Abu Dhabi')+'"></label><label>Pickup date and time<input name="pickupAt" type="datetime-local" required></label><label>Drop-off date and time<input name="dropoffAt" type="datetime-local" required></label><p class="muted">Optional location sharing stays off unless you later click “Start sharing location” and allow your browser to share your location. You can stop it at any time.</p><button class="btn" type="submit">Send booking request</button><div class="feedback" role="status"></div><div class="share"></div></form></div></article>').join('');
  target.querySelectorAll('[data-open]').forEach(btn=>btn.onclick=()=>{const form=target.querySelector('[data-booking="'+btn.dataset.open+'"]');form.classList.toggle('open');});
  target.querySelectorAll('[data-booking]').forEach(form=>form.onsubmit=async ev=>{
   ev.preventDefault();const feedback=form.querySelector('.feedback'),share=form.querySelector('.share'),fd=new FormData(form),payload=Object.fromEntries(fd);
   const carId=form.dataset.booking;
   const start=new Date(payload.pickupAt),end=new Date(payload.dropoffAt);
   if(start<=new Date()||end<=start){feedback.textContent='Please choose a future pickup and a later drop-off.';return;}
   payload.pickupAt=start.toISOString();payload.dropoffAt=end.toISOString();payload.carId=carId;
   const submit=form.querySelector('button[type=submit]');submit.disabled=true;feedback.textContent='Submitting booking request…';
   try{
    const r=await fetch('/api/bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const result=await r.json();if(!r.ok){if(r.status===401)throw new Error('Please sign in first, then return to the fleet to send your booking request.');throw new Error(result.error||'Booking failed.');}
    const id=result.booking._id,token=result.locationAccessToken;sessionStorage.setItem('rentacar_booking_'+id,token);
    feedback.textContent='Booking request submitted. Reference: '+id+'. Estimated total: '+Number(result.booking.totalPrice).toFixed(2)+' '+esc(result.booking.currency)+'. Keep this browser tab open to manage optional location sharing.';
    share.innerHTML='<button type="button" class="btn" data-start-share>Start sharing location</button><button type="button" class="btn secondary" data-stop-share disabled>Stop sharing</button><p class="muted">Location sharing is off unless you click Start and approve the browser location prompt.</p>';
    let watchId=null,stopped=false;
    const callConsent=async value=>{const rr=await fetch('/api/bookings/'+encodeURIComponent(id)+'/location-consent',{method:'POST',headers:{'Content-Type':'application/json','x-booking-token':token},body:JSON.stringify({consent:value})});const dd=await rr.json();if(!rr.ok)throw new Error(dd.error||'Could not change location sharing.');return dd;};
    share.querySelector('[data-start-share]').onclick=async()=>{
      if(!navigator.geolocation){feedback.textContent='This browser does not support location sharing.';return;}
      try{await callConsent(true);stopped=false;share.querySelector('[data-start-share]').disabled=true;share.querySelector('[data-stop-share]').disabled=false;feedback.textContent='Location sharing is enabled. Your browser may ask for permission; you can stop at any time.';
       watchId=navigator.geolocation.watchPosition(async pos=>{if(stopped)return;try{const rr=await fetch('/api/bookings/'+encodeURIComponent(id)+'/location',{method:'POST',headers:{'Content-Type':'application/json','x-booking-token':token},body:JSON.stringify({latitude:pos.coords.latitude,longitude:pos.coords.longitude})});if(!rr.ok){const dd=await rr.json();throw new Error(dd.error||'Location update failed.');}feedback.textContent='Location shared at '+new Date().toLocaleTimeString()+'. Sharing is on; use Stop sharing whenever you want.';}catch(e){feedback.textContent=e.message;}},err=>{feedback.textContent='Location was not shared: '+err.message+'. You can try again or leave sharing off.';},{enableHighAccuracy:false,maximumAge:15000,timeout:12000});
      }catch(e){feedback.textContent=e.message;}
    };
    share.querySelector('[data-stop-share]').onclick=async()=>{stopped=true;if(watchId!==null)navigator.geolocation.clearWatch(watchId);watchId=null;try{await callConsent(false);share.querySelector('[data-start-share]').disabled=false;share.querySelector('[data-stop-share]').disabled=true;feedback.textContent='Location sharing stopped and the last saved location cleared.';}catch(e){feedback.textContent=e.message;}};
    form.querySelectorAll('input').forEach(el=>{if(el.type!=='checkbox')el.disabled=true;});submit.textContent='Booking sent';
   }catch(e){feedback.textContent=e.message;}finally{submit.disabled=false;}
  });
 }catch(e){target.innerHTML='<div class="empty"><h2>Cars are temporarily unavailable</h2><p class="muted">Please try again shortly.</p></div>';notice.textContent=e.message;}
})();
</script></body></html>