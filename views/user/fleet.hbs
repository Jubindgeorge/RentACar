<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>RentACar | Fleet</title>
<style>
:root{font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:#152238;background:#f4f7fb}*{box-sizing:border-box}body{margin:0}header{background:#101c32;color:white;padding:22px max(20px,calc((100% - 1120px)/2));display:flex;justify-content:space-between;align-items:center;gap:16px;flex-wrap:wrap}header a{color:white;text-decoration:none;margin-left:16px}.hero{max-width:1120px;margin:36px auto 20px;padding:0 20px}.hero h1{font-size:clamp(30px,5vw,48px);margin:0 0 8px}.muted{color:#66758a}.grid{max-width:1120px;margin:0 auto;padding:0 20px 48px;display:grid;grid-template-columns:repeat(auto-fit,minmax(270px,1fr));gap:20px}.card{background:white;border:1px solid #e1e8f0;border-radius:18px;overflow:hidden;box-shadow:0 8px 26px #1327430c}.card img{width:100%;height:180px;object-fit:cover;background:#e7edf5}.content{padding:18px}.price{font-size:24px;font-weight:800;color:#0a7968}.pill{display:inline-block;background:#e6f7f3;color:#087665;border-radius:999px;padding:5px 10px;font-size:12px;font-weight:700}.empty{grid-column:1/-1;background:white;padding:28px;border-radius:16px}.btn{display:inline-block;background:#087f72;color:white;text-decoration:none;border:0;border-radius:10px;padding:12px 16px;font-weight:700;cursor:pointer}.secondary{background:#e7edf5;color:#24344b}.notice{max-width:1120px;margin:0 auto 20px;padding:0 20px;color:#9a3412}.booking{display:none;border-top:1px solid #e1e8f0;margin-top:16px;padding-top:16px}.booking.open{display:block}.booking label{display:block;font-size:13px;font-weight:700;margin-top:10px}.booking input{width:100%;padding:11px;border:1px solid #ccd6e2;border-radius:9px;margin-top:5px;font:inherit}.consent{display:flex;gap:9px;align-items:flex-start;font-size:13px;color:#526174;margin:14px 0}.consent input{width:auto;margin-top:3px}.feedback{font-size:13px;line-height:1.5;overflow-wrap:anywhere;margin-top:12px}.share{margin-top:10px;display:flex;gap:8px;flex-wrap:wrap}footer{text-align:center;padding:25px;color:#68768b}@media(max-width:600px){header{align-items:flex-start}header nav a{margin:0 12px 0 0}}
</style></head><body>
<header><strong>RentACar</strong><nav><a href="/">Home</a><a href="/fleet">Browse cars</a><a href="/users/login">Sign in</a></nav></header>
<section class="hero"><h1>Find your next ride.</h1><p class="muted">Explore available vehicles and submit a rental request. Rates are shown per day in AED unless specified.</p></section>
<div id="notice" class="notice" role="status"></div><main id="cars" class="grid"><div class="empty">Loading available cars…</div></main><footer>RentACar · Drive with confidence</footer>
<script>
(async function(){
 const target=document.getElementById('cars'),notice=document.getElementById('notice');
 const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
 try{
  const response=await fetch('/api/cars');const data=await response.json();if(!response.ok)throw new Error(data.error||'Unable to load cars.');
  if(!data.cars.length){target.innerHTML='<div class="empty"><h2>No cars listed yet</h2><p class="muted">Please check back soon.</p></div>';return;}
  target.innerHTML=data.cars.map(car=>'<article class="card">'+(car.imageUrl?'<img loading="lazy" src="'+esc(car.imageUrl)+'" alt="'+esc(car.name)+'">':'<div style="height:180px;display:grid;place-items:center;background:#e7edf5;color:#75849a">Vehicle image not available</div>')+'<div class="content"><span class="pill">'+esc(car.category||'Standard')+'</span><h2>'+esc(car.name)+'</h2><p class="muted">'+esc(car.brand)+' '+esc(car.model)+' · '+car.seats+' seats · '+esc(car.transmission)+'</p><p>'+esc(car.description||'Comfortable, reliable rental vehicle.')+'</p><div class="price">'+Number(car.dailyRate).toLocaleString(undefined,{maximumFractionDigits:2})+' '+esc(car.currency||'AED')+' <small style="font-size:13px;font-weight:500">/ day</small></div><button class="btn" style="margin-top:14px" data-open="'+car._id+'">Request booking</button><form class="booking" data-booking="'+car._id+'"><label>Full name<input name="customerName" autocomplete="name" required maxlength="120"></label><label>Email<input name="customerEmail" type="email" autocomplete="email" required maxlength="254"></label><label>Phone<input name="customerPhone" type="tel" autocomplete="tel" required maxlength="40"></label><label>Pickup location<input name="pickupLocation" required maxlength="200" value="'+esc(car.pickupLocation||'Abu Dhabi')+'"></label><label>Drop-off location<input name="dropoffLocation" required maxlength="200" value="'+esc(car.pickupLocation||'Abu Dhabi')+'"></label><label>Pickup date and time<input name="pickupAt" type="datetime-local" required></label><label>Drop-off date and time<input name="dropoffAt" type="datetime-local" required></label><label class="consent"><input name="locationConsent" type="checkbox"><span>I explicitly consent to optional location sharing for this booking. It will remain off unless I enable it, and I can stop sharing at any time.</span></label><button class="btn" type="submit">Send booking request</button><div class="feedback" role="status"></div><div class="share"></div></form></div></article>').join('');
  target.querySelectorAll('[data-open]').forEach(btn=>btn.onclick=()=>{const form=target.querySelector('[data-booking="'+btn.dataset.open+'"]');form.classList.toggle('open');});
  target.querySelectorAll('[data-booking]').forEach(form=>form.onsubmit=async ev=>{
   ev.preventDefault();const feedback=form.querySelector('.feedback'),share=form.querySelector('.share'),fd=new FormData(form),payload=Object.fromEntries(fd);
   const carId=form.dataset.booking,consent=payload.locationConsent==='on';delete payload.locationConsent;
   const start=new Date(payload.pickupAt),end=new Date(payload.dropoffAt);
   if(start<=new Date()||end<=start){feedback.textContent='Please choose a future pickup and a later drop-off.';return;}
   payload.pickupAt=start.toISOString();payload.dropoffAt=end.toISOString();payload.carId=carId;
   const submit=form.querySelector('button[type=submit]');submit.disabled=true;feedback.textContent='Submitting booking request…';
   try{
    const r=await fetch('/api/bookings',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const result=await r.json();if(!r.ok)throw new Error(result.error||'Booking failed.');
    const id=result.booking._id,token=result.locationAccessToken;sessionStorage.setItem('rentacar_booking_'+id,token);
    feedback.textContent='Booking request submitted. Reference: '+id+'. Estimated total: '+Number(result.booking.totalPrice).toFixed(2)+' '+esc(result.booking.currency)+'. Keep this browser tab open to manage optional location sharing.';
    share.innerHTML='<button type="button" class="btn" data-start-share>Start sharing location</button><button type="button" class="btn secondary" data-stop-share disabled>Stop sharing</button><p class="muted">Location sharing is off unless you click Start and approve the browser location prompt.</p>';
    let watchId=null,stopped=false;
    const callConsent=async value=>{const rr=await fetch('/api/bookings/'+encodeURIComponent(id)+'/location-consent',{method:'POST',headers:{'Content-Type':'application/json','x-booking-token':token},body:JSON.stringify({consent:value})});const dd=await rr.json();if(!rr.ok)throw new Error(dd.error||'Could not change location sharing.');return dd;};
    share.querySelector('[data-start-share]').onclick=async()=>{
      if(!navigator.geolocation){feedback.textContent='This browser does not support location sharing.';return;}
      try{await callConsent(true);stopped=false;share.querySelector('[data-start-share]').disabled=true;share.querySelector('[data-stop-share]').disabled=false;feedback.textContent='Location sharing is enabled. Your browser may ask for permission; you can stop at any time.';
       watchId=navigator.geolocation.watchPosition(async pos=>{if(stopped)return;try{const rr=await fetch('/api/bookings/'+encodeURIComponent(id)+'/location',{method:'POST',headers:{'Content-Type':'application/json','x-booking-token':token},body:JSON.stringify({latitude:pos.coords.latitude,longitude:pos.coords.longitude})});if(!rr.ok){const dd=await rr.json();throw new Error(dd.error||'Location update failed.');}feedback.textContent='Location shared at '+new Date().toLocaleTimeString()+'. Sharing is on; use Stop sharing whenever you want.';}catch(e){feedback.textContent=e.message;}},err=>{feedback.textContent='Location was not shared: '+err.message+'. You can try again or leave sharing off.';},{enableHighAccuracy:false,maximumAge:15000,timeout:12000});
      }catch(e){feedback.textContent=e.message;}
    };
    share.querySelector('[data-stop-share]').onclick=async()=>{stopped=true;if(watchId!==null)navigator.geolocation.clearWatch(watchId);watchId=null;try{await callConsent(false);share.querySelector('[data-start-share]').disabled=false;share.querySelector('[data-stop-share]').disabled=true;feedback.textContent='Location sharing stopped and the last saved location cleared.';}catch(e){feedback.textContent=e.message;}};
    form.querySelectorAll('input').forEach(el=>{if(el.type!=='checkbox')el.disabled=true;});submit.textContent='Booking sent';
   }catch(e){feedback.textContent=e.message;}finally{submit.disabled=false;}
  });
 }catch(e){target.innerHTML='<div class="empty"><h2>Cars are temporarily unavailable</h2><p class="muted">Please try again shortly.</p></div>';notice.textContent=e.message;}
})();
</script></body></html>